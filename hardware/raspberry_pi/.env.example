# 이 파일을 .env 로 복사해서 쓰세요.

# 프-백 주소. 라즈베리파이에서는 localhost가 아니라 노트북의 IP를 적어야 합니다.
API_BASE_URL=http://192.168.0.10:8000/api/v1

# 라즈베리파이가 로그인할 계정.
# 번역기 화면이 이 계정의 최근 촬영을 폴링하므로, 농인 계정이어야 합니다.
API_NICKNAME=민지
API_PASSWORD=password

# 채팅방에 올리려면 대화 ID를 넣습니다. 비우면 번역기 모드(대면)로 올라갑니다.
CONVERSATION_ID=

# 이 장치의 식별자. oneM2M 메타데이터에 그대로 올라갑니다.
DEVICE_ID=rpi-demo-01

# 아두이노 시리얼 포트 (ls /dev/tty* 로 확인)
SERIAL_PORT=/dev/ttyACM0
SERIAL_BAUD=115200

# 촬영 길이 (명세 7.1 권장 최대 30초)
RECORD_SECONDS=5
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
