# 이 파일을 .env 로 복사해서 쓰세요. .env 는 git에 올라가지 않습니다.
# ⚠️ 실제 키는 여기에 적지 마세요. 이 파일은 git에 올라갑니다.

DJANGO_SECRET_KEY=dev-insecure-change-me
DJANGO_DEBUG=True

# 프론트 오리진. 명세 10장: 백엔드는 허용할 프론트 Origin을 명시적으로 CORS 설정해야 합니다.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# 인-백이 결과 콜백을 호출할 때 쓰는 내부 API Key (명세 20장)
AI_CALLBACK_API_KEY=dev-internal-key

# 인-백 주소. 비워두면 가짜 인식부(28.5)가 동작합니다.
AI_SERVER_URL=
AI_TIMEOUT_SECONDS=30

# --- COSS 플랫폼 (oneM2M / Mobius) ---
# 비워두면 등록을 건너뜁니다 (27장: 등록 실패가 영상·AI 결과를 삭제하지 않음).
# 값은 포털(https://platform.iotcoss.ac.kr) 에서 발급받습니다.
ONEM2M_BASE_URL=https://onem2m.iotcoss.ac.kr
ONEM2M_CSE_NAME=Mobius
# 포털에서 발급받은 API Key
ONEM2M_API_KEY=
# 수강 목록의 수업 ID (예: LCT_20260002)
ONEM2M_LECTURE_ID=
# 학교 코드 + 학번 식별 코드
ONEM2M_CREATOR=
ONEM2M_AE_NAME=
# AE 생성 후 응답의 aei 값 (보통 'S' + AE 이름)
ONEM2M_ORIGINATOR=
ONEM2M_TIMEOUT_SECONDS=5
